# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me-long-random-string
# Key for the HTTP API (X-API-Key header), at least 16 characters: openssl rand -hex 24
API_KEY=change-me-0123456789abcdef

# Live mode only. Wialon access token (User settings -> Access tokens), read-only rights are enough.
WIALON_TOKEN=
# Wialon Hosting: https://hst-api.wialon.com ; Wialon Local / white-label: your own https host
WIALON_HOST=https://hst-api.wialon.com

# Referenced from the rules file as ${TELEGRAM_BOT_TOKEN} / ${TELEGRAM_CHAT_ID} / ${WEBHOOK_SECRET}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_SECRET=
